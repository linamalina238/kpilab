@startuml
left to right direction

actor "Користувач" as User
actor "Покупець" as Buyer

Buyer --|> User

rectangle "Інтернет-магазин" {
  usecase "UC-01 Переглянути товари категорії" as UC01
  usecase "UC-02 Оформити й оплатити замовлення" as UC02 #LightBlue
  usecase "UC-03 Переглянути статус замовлення" as UC03
}

User --> UC01
Buyer --> UC02
Buyer --> UC03

UC02 .> UC01 : <<include>>
UC03 .> UC02 : <<extend>>\n(оплату завершено:\nOrder.status = paid або cancelled)
@enduml